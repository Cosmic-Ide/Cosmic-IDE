#!/bin/sh

set -eu

ARCH="${ALARM_ARCH:-aarch64}"
MIRROR="${ALARM_MIRROR:-http://mirror.archlinuxarm.org}"
REPOSITORIES="${ALARM_REPOSITORIES:-core extra alarm aur}"

usage() {
    cat >&2 <<EOF_USAGE
usage:
  alarm-pkg <package-name> [package-name...]
  alarm-pkg --download-only <package-name> [package-name...]
  alarm-pkg --install-file <package.pkg.tar.*> [package.pkg.tar.*]
  alarm-pkg --prefix <path> <package-name> [package-name...]

environment:
  ALARM_ARCH          package architecture, default: aarch64
  ALARM_MIRROR        mirror base, default: https://mirror.archlinuxarm.org
  ALARM_REPOSITORIES  space-separated repository priority order,
                      default: core extra alarm aur
  ALARM_CACHE         package download and repository database cache
  ALARM_PREFIX        target Arch root override; paths ending in /usr are accepted

examples:
  alarm-pkg pacman
  alarm-pkg pacman libarchive gpgme
  alarm-pkg --download-only pacman
  alarm-pkg --install-file pacman.pkg.tar.xz
  ALARM_REPOSITORIES="core extra alarm" alarm-pkg pacman
EOF_USAGE
    exit 1
}

die() {
    echo "error: $*" >&2
    exit 1
}

warn() {
    echo "warning: $*" >&2
}

command_path() {
    command -v "$1" 2>/dev/null || return 1
}

resolve_path() {
    path="$1"

    if command -v readlink >/dev/null 2>&1; then
        resolved="$(readlink -f "$path" 2>/dev/null || true)"
        if [ -n "$resolved" ]; then
            path="$resolved"
        fi
    fi

    printf '%s\n' "$path"
}

normalize_prefix() {
    prefix="${1%/}"

    [ -n "$prefix" ] || die "installation prefix cannot be empty"

    # Accept either the target root or its effective /usr directory.
    # Internally always keep the target Arch root.
    case "$prefix" in
        /usr)
            ;;
        */usr)
            prefix="${prefix%/usr}"
            ;;
    esac

    printf '%s\n' "$prefix"
}

detect_prefix() {
    if [ -n "${ALARM_PREFIX:-}" ]; then
        normalize_prefix "$ALARM_PREFIX"
        return
    fi

    for executable in xz tar curl wget sh; do
        path="$(command_path "$executable" || true)"
        [ -n "$path" ] || continue

        path="$(resolve_path "$path")"

        case "$path" in
            # Bootstrap tools under glibc/usr install bootstrap packages into
            # the glibc tree itself. The separate arch tree is managed only by
            # pacman using --root.
            */glibc/usr/bin/*|*/glibc/usr/sbin/*)
                files_dir="${path%%/glibc/usr/*}"
                printf '%s\n' "$files_dir/glibc"
                return
                ;;

            # Once the Arch tree is usable, tools may resolve from arch/usr.
            */arch/usr/bin/*|*/arch/usr/sbin/*)
                printf '%s\n' "${path%%/usr/*}"
                return
                ;;

            */usr/bin/*)
                usr_prefix="${path%%/bin/*}"

                case "$usr_prefix" in
                    /usr)
                        ;;
                    */usr)
                        normalize_prefix "$usr_prefix"
                        return
                        ;;
                esac
                ;;

            */usr/sbin/*)
                usr_prefix="${path%%/sbin/*}"

                case "$usr_prefix" in
                    /usr)
                        ;;
                    */usr)
                        normalize_prefix "$usr_prefix"
                        return
                        ;;
                esac
                ;;
        esac
    done

    die "could not detect the target Arch root; use --prefix or ALARM_PREFIX"
}

download_to() {
    download_url="$1"
    download_destination="$2"

    if command -v curl >/dev/null 2>&1; then
        curl -fL \
            --retry 3 \
            --retry-delay 1 \
            "$download_url" \
            -o "$download_destination"
        return
    fi

    if command -v wget >/dev/null 2>&1; then
        wget -O "$download_destination" "$download_url"
        return
    fi

    die "curl or wget is required"
}

extract_repository_database() {
    database_file="$1"
    destination="$2"
    tar_bin="$(command_path tar || true)"

    [ -n "$tar_bin" ] || die "tar is required"

    rm -rf "$destination"
    mkdir -p "$destination"

    # GNU tar and many other tar implementations auto-detect the compression
    # from the file contents, even though sync databases normally end in .db.
    if "$tar_bin" -xpf "$database_file" \
        --no-same-owner \
        --no-same-permissions \
        -C "$destination" 2>/dev/null; then
        return
    fi

    rm -rf "$destination"
    mkdir -p "$destination"

    if command -v gzip >/dev/null 2>&1 && gzip -t "$database_file" >/dev/null 2>&1; then
        gzip -dc "$database_file" |
            "$tar_bin" -xpf - \
                --no-same-owner \
                --no-same-permissions \
                -C "$destination"
        return
    fi

    if command -v zstd >/dev/null 2>&1 && zstd -t "$database_file" >/dev/null 2>&1; then
        zstd -dc "$database_file" |
            "$tar_bin" -xpf - \
                --no-same-owner \
                --no-same-permissions \
                -C "$destination"
        return
    fi

    if command -v xz >/dev/null 2>&1 && xz -t "$database_file" >/dev/null 2>&1; then
        xz -dc "$database_file" |
            "$tar_bin" -xpf - \
                --no-same-owner \
                --no-same-permissions \
                -C "$destination"
        return
    fi

    die "could not extract repository database: $database_file"
}

refresh_repository() {
    repository="$1"
    repository_rank="$2"
    database_file="$DB_CACHE/$repository.db"
    partial_file="$database_file.part"
    database_url="$MIRROR/$ARCH/$repository/$repository.db"
    extracted_dir="$WORK_DIR/repositories/$repository"

    echo "syncing database: $repository" >&2
    rm -f "$partial_file"

    if download_to "$database_url" "$partial_file"; then
        mv -f "$partial_file" "$database_file"
    elif [ -f "$database_file" ]; then
        rm -f "$partial_file"
        warn "could not refresh $repository; using cached database"
    else
        rm -f "$partial_file"
        warn "repository is unavailable and has no cached database: $repository"
        return 1
    fi

    if ! extract_repository_database "$database_file" "$extracted_dir"; then
        warn "could not read repository database: $repository"
        return 1
    fi

    if ! find "$extracted_dir" -type f -name desc | awk '{ print; exit }' | grep -q .; then
        warn "repository database contains no package descriptions: $repository"
        return 1
    fi

    build_repository_index "$repository" "$repository_rank" "$extracted_dir"
}

build_repository_index() {
    repository="$1"
    repository_rank="$2"
    extracted_dir="$3"

    # One awk process handles many desc files at once. Each desc file follows
    # the ALPM sync database format with sections such as %NAME%, %FILENAME%,
    # %VERSION%, %PROVIDES%, and %DEPENDS%.
    find "$extracted_dir" -type f -name desc -exec awk \
        -v repository="$repository" \
        -v repository_rank="$repository_rank" \
        -v packages_file="$PACKAGES_RAW" \
        -v providers_file="$PROVIDERS_RAW" '
        function reset_record() {
            name = ""
            version = ""
            filename = ""
            provides = ""
            desc_path = ""
            section = ""
        }

        function relation_name(relation, result) {
            result = relation
            sub(/[<>=].*$/, "", result)
            return result
        }

        function emit_record(    count, values, item_index, provided_name) {
            if (name == "") {
                return
            }

            print repository_rank "|" name "|" repository "|" version "|" filename "|" desc_path >> packages_file

            if (provides == "") {
                return
            }

            count = split(provides, values, separator)
            for (item_index = 1; item_index <= count; item_index++) {
                provided_name = relation_name(values[item_index])
                if (provided_name != "") {
                    print provided_name "|" repository_rank "|" name "|" repository "|" version "|" filename "|" desc_path >> providers_file
                }
            }
        }

        BEGIN {
            separator = sprintf("%c", 28)
            have_record = 0
            reset_record()
        }

        FNR == 1 {
            if (have_record) {
                emit_record()
            }
            reset_record()
            desc_path = FILENAME
            have_record = 1
        }

        /^%[^%]+%$/ {
            section = $0
            next
        }

        /^$/ {
            section = ""
            next
        }

        section == "%NAME%" {
            name = $0
            next
        }

        section == "%VERSION%" {
            version = $0
            next
        }

        section == "%FILENAME%" {
            filename = $0
            next
        }

        section == "%PROVIDES%" {
            if (provides == "") {
                provides = $0
            } else {
                provides = provides separator $0
            }
            next
        }

        END {
            if (have_record) {
                emit_record()
            }
        }
    ' {} +
}

finalize_indexes() {
    LC_ALL=C sort -t '|' -k1,1n -k2,2 "$PACKAGES_RAW" > "$PACKAGES_INDEX"
    LC_ALL=C sort -t '|' -k1,1 -k2,2n -k3,3 "$PROVIDERS_RAW" > "$PROVIDERS_INDEX"

    [ -s "$PACKAGES_INDEX" ] || die "no packages were found in the configured repositories"
}

relation_name() {
    printf '%s\n' "$1" | sed 's/[<>=].*$//'
}

lookup_exact_package() {
    package_name="$1"

    awk -F '|' -v package_name="$package_name" '
        $2 == package_name {
            print $2 "|" $3 "|" $4 "|" $5 "|" $6
            exit
        }
    ' "$PACKAGES_INDEX"
}

lookup_provider() {
    provided_name="$1"

    awk -F '|' -v provided_name="$provided_name" '
        $1 == provided_name {
            print $3 "|" $4 "|" $5 "|" $6 "|" $7
            exit
        }
    ' "$PROVIDERS_INDEX"
}

count_providers() {
    provided_name="$1"

    awk -F '|' -v provided_name="$provided_name" '
        $1 == provided_name {
            count++
        }
        END {
            print count + 0
        }
    ' "$PROVIDERS_INDEX"
}

resolve_record() {
    requested_relation="$1"
    requested_name="$(relation_name "$requested_relation")"

    RESOLVED_RECORD="$(lookup_exact_package "$requested_name")"
    RESOLVED_VIRTUAL=""

    if [ -z "$RESOLVED_RECORD" ]; then
        RESOLVED_RECORD="$(lookup_provider "$requested_name")"
        RESOLVED_VIRTUAL="$requested_name"
    fi

    [ -n "$RESOLVED_RECORD" ] || return 1

    old_ifs="$IFS"
    IFS='|'
    read -r RESOLVED_NAME RESOLVED_REPOSITORY RESOLVED_VERSION RESOLVED_FILENAME RESOLVED_DESC <<EOF_RECORD
$RESOLVED_RECORD
EOF_RECORD
    IFS="$old_ifs"

    [ -n "$RESOLVED_FILENAME" ] ||
        die "repository record for $RESOLVED_NAME has no package filename"

    if [ -n "$RESOLVED_VIRTUAL" ] && [ "$RESOLVED_VIRTUAL" != "$RESOLVED_NAME" ]; then
        provider_count="$(count_providers "$RESOLVED_VIRTUAL")"
        if [ "$provider_count" -gt 1 ]; then
            echo "provider: $RESOLVED_VIRTUAL -> $RESOLVED_NAME ($provider_count candidates, first by repository priority)" >&2
        else
            echo "provider: $RESOLVED_VIRTUAL -> $RESOLVED_NAME" >&2
        fi
    fi
}

read_desc_section() {
    desc_file="$1"
    wanted_section="$2"
    wanted_marker="%${wanted_section}%"

    awk -v wanted="$wanted_marker" '
        $0 == wanted {
            inside = 1
            next
        }

        inside && /^$/ {
            exit
        }

        inside {
            print
        }
    ' "$desc_file"
}

list_contains() {
    list_file="$1"
    value="$2"

    grep -Fqx "$value" "$list_file" 2>/dev/null
}

remove_from_list() {
    list_file="$1"
    value="$2"
    temporary_file="$list_file.tmp.$$"

    grep -Fvx "$value" "$list_file" > "$temporary_file" 2>/dev/null || true
    mv -f "$temporary_file" "$list_file"
}

resolve_recursive() {
    # Use a subshell to give each recursive call its own variables while
    # keeping the resolver POSIX-sh compatible. State is shared through files.
    (
        requested_relation="$1"
        required_by="${2:-}"

        if ! resolve_record "$requested_relation"; then
            if [ -n "$required_by" ]; then
                die "dependency '$requested_relation' required by '$required_by' was not found in: $REPOSITORIES"
            fi
            die "package or provider '$requested_relation' was not found in: $REPOSITORIES"
        fi

        package_name="$RESOLVED_NAME"

        if list_contains "$RESOLVED_PACKAGES" "$package_name"; then
            exit 0
        fi

        if list_contains "$RESOLVING_PACKAGES" "$package_name"; then
            echo "dependency cycle: $package_name" >&2
            exit 0
        fi

        echo "resolving: $package_name ($RESOLVED_REPOSITORY $RESOLVED_VERSION)" >&2
        printf '%s\n' "$package_name" >> "$RESOLVING_PACKAGES"

        dependencies_file="$(mktemp "$WORK_DIR/dependencies.XXXXXX")"
        read_desc_section "$RESOLVED_DESC" DEPENDS > "$dependencies_file"

        while IFS= read -r dependency || [ -n "$dependency" ]; do
            [ -n "$dependency" ] || continue
            resolve_recursive "$dependency" "$package_name"
        done < "$dependencies_file"

        rm -f "$dependencies_file"
        remove_from_list "$RESOLVING_PACKAGES" "$package_name"

        if ! list_contains "$RESOLVED_PACKAGES" "$package_name"; then
            printf '%s|%s|%s|%s|%s\n' \
                "$RESOLVED_NAME" \
                "$RESOLVED_REPOSITORY" \
                "$RESOLVED_VERSION" \
                "$RESOLVED_FILENAME" \
                "$RESOLVED_DESC" >> "$INSTALL_ORDER"
            printf '%s\n' "$package_name" >> "$RESOLVED_PACKAGES"
        fi
    )
}

extract_archive() {
    package_file="$1"
    destination="$2"

    tar_bin="$(command_path tar || true)"
    [ -n "$tar_bin" ] || die "tar is required"

    case "$package_file" in
        *.pkg.tar.xz|*.tar.xz|*.txz)
            xz_bin="$(command_path xz || true)"
            [ -n "$xz_bin" ] || die "xz is required for $package_file"

            "$xz_bin" -dc "$package_file" |
                "$tar_bin" -xpf - \
                    --no-same-owner \
                    --no-same-permissions \
                    -C "$destination"
            ;;

        *.pkg.tar.zst|*.tar.zst)
            zstd_bin="$(command_path zstd || true)"
            [ -n "$zstd_bin" ] || die "zstd is required for $package_file"

            "$zstd_bin" -dc "$package_file" |
                "$tar_bin" -xpf - \
                    --no-same-owner \
                    --no-same-permissions \
                    -C "$destination"
            ;;

        *.pkg.tar.gz|*.tar.gz|*.tgz)
            gzip_bin="$(command_path gzip || true)"
            [ -n "$gzip_bin" ] || die "gzip is required for $package_file"

            "$gzip_bin" -dc "$package_file" |
                "$tar_bin" -xpf - \
                    --no-same-owner \
                    --no-same-permissions \
                    -C "$destination"
            ;;

        *.pkg.tar.bz2|*.tar.bz2|*.tbz2)
            bzip2_bin="$(command_path bzip2 || true)"
            [ -n "$bzip2_bin" ] || die "bzip2 is required for $package_file"

            "$bzip2_bin" -dc "$package_file" |
                "$tar_bin" -xpf - \
                    --no-same-owner \
                    --no-same-permissions \
                    -C "$destination"
            ;;

        *.pkg.tar|*.tar)
            "$tar_bin" -xpf "$package_file" \
                --no-same-owner \
                --no-same-permissions \
                -C "$destination"
            ;;

        *)
            die "unsupported package archive: $package_file"
            ;;
    esac
}

merge_tree() {
    source="$1"
    destination="$2"

    [ -d "$source" ] || return 0

    tar_bin="$(command_path tar || true)"
    [ -n "$tar_bin" ] || die "tar is required"

    mkdir -p "$destination"

    (
        cd "$source"
        "$tar_bin" -cpf - .
    ) |
        (
            cd "$destination"
            "$tar_bin" -xpf - \
                --no-same-owner \
                --no-same-permissions
        )
}

merge_root_directory() {
    source="$1"
    destination="$2"

    # Root-level bin/lib/sbin entries in modern Arch packages are usually
    # symlinks into /usr. The compatibility layer already virtualizes those
    # paths, so do not follow and duplicate those symlink targets.
    [ -d "$source" ] || return 0
    [ ! -L "$source" ] || return 0

    merge_tree "$source" "$destination"
}

install_archive() {
    package_file="$1"
    root_prefix="$2"
    usr_prefix="$root_prefix/usr"

    [ -f "$package_file" ] ||
        die "package file not found: $package_file"

    mkdir -p "$usr_prefix"

    stage="$(mktemp -d "$WORK_DIR/stage.XXXXXX")"

    echo "extracting: $package_file" >&2
    extract_archive "$package_file" "$stage"

    # Keep the flattened Cosmic Arch layout:
    #
    #   package /usr/* -> arch/usr/*
    #   package /etc/* -> arch/usr/etc/*
    #   package /var/* -> arch/usr/var/*
    #
    # Only selected top-level directories are copied. Package metadata and
    # other root entries such as .BUILDINFO, .INSTALL, .MTREE and .PKGINFO
    # remain in the temporary staging directory and are discarded.
    merge_tree "$stage/usr" "$usr_prefix"

    merge_root_directory "$stage/etc" "$usr_prefix/etc"
    merge_root_directory "$stage/var" "$usr_prefix/var"
    merge_root_directory "$stage/opt" "$usr_prefix/opt"
    merge_root_directory "$stage/run" "$usr_prefix/run"
    merge_root_directory "$stage/srv" "$usr_prefix/srv"
    merge_root_directory "$stage/home" "$usr_prefix/home"

    # Copy genuine legacy directories, but ignore modern root symlinks such as
    # /bin -> usr/bin and /lib -> usr/lib to avoid duplicating their contents.
    merge_root_directory "$stage/bin" "$usr_prefix/bin"
    merge_root_directory "$stage/sbin" "$usr_prefix/sbin"
    merge_root_directory "$stage/lib" "$usr_prefix/lib"
    merge_root_directory "$stage/lib64" "$usr_prefix/lib64"

    rm -rf "$stage"

    echo "installed: $package_file" >&2
}

DOWNLOAD_ONLY=0
INSTALL_FILES=0
PREFIX_OVERRIDE=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --download-only|-d)
            DOWNLOAD_ONLY=1
            shift
            ;;

        --install-file|-i)
            INSTALL_FILES=1
            shift
            break
            ;;

        --prefix)
            [ "$#" -ge 2 ] || usage
            PREFIX_OVERRIDE="$2"
            shift 2
            ;;

        --prefix=*)
            PREFIX_OVERRIDE="${1#*=}"
            shift
            ;;

        --help|-h)
            usage
            ;;

        --)
            shift
            break
            ;;

        -*)
            die "unknown option: $1"
            ;;

        *)
            break
            ;;
    esac
done

[ "$#" -gt 0 ] || usage

if [ -n "$PREFIX_OVERRIDE" ]; then
    ALARM_PREFIX="$PREFIX_OVERRIDE"
    export ALARM_PREFIX
fi

PREFIX="$(detect_prefix)"
USR_PREFIX="$PREFIX/usr"
CACHE="${ALARM_CACHE:-$USR_PREFIX/var/cache/alarm-pkg}"
DB_CACHE="$CACHE/databases"

mkdir -p "$USR_PREFIX" "$CACHE" "$DB_CACHE"

TMP_BASE="${TMPDIR:-$CACHE}"
mkdir -p "$TMP_BASE"
WORK_DIR="$(mktemp -d "$TMP_BASE/alarm-pkg.XXXXXX")"
trap 'rm -rf "$WORK_DIR"' EXIT HUP INT TERM

PACKAGES_RAW="$WORK_DIR/packages.raw"
PROVIDERS_RAW="$WORK_DIR/providers.raw"
PACKAGES_INDEX="$WORK_DIR/packages.index"
PROVIDERS_INDEX="$WORK_DIR/providers.index"
RESOLVING_PACKAGES="$WORK_DIR/resolving"
RESOLVED_PACKAGES="$WORK_DIR/resolved"
INSTALL_ORDER="$WORK_DIR/install-order"

: > "$PACKAGES_RAW"
: > "$PROVIDERS_RAW"
: > "$RESOLVING_PACKAGES"
: > "$RESOLVED_PACKAGES"
: > "$INSTALL_ORDER"

mkdir -p "$WORK_DIR/repositories"

echo "root:   $PREFIX" >&2
echo "usr:    $USR_PREFIX" >&2
echo "cache:  $CACHE" >&2

if [ "$INSTALL_FILES" -eq 1 ]; then
    for package_file in "$@"; do
        install_archive "$package_file" "$PREFIX"
    done

    exit 0
fi

repository_rank=0
repository_count=0

for repository in $REPOSITORIES; do
    repository_rank=$((repository_rank + 1))
    if refresh_repository "$repository" "$repository_rank"; then
        repository_count=$((repository_count + 1))
    fi
done

[ "$repository_count" -gt 0 ] || die "none of the configured repositories could be loaded"

finalize_indexes

for requested_package in "$@"; do
    resolve_recursive "$requested_package"
done

package_count="$(wc -l < "$INSTALL_ORDER" | tr -d '[:space:]')"
echo "resolved $package_count package(s), dependencies first" >&2

while IFS='|' read -r package_name repository version filename desc_file || [ -n "$package_name" ]; do
    [ -n "$package_name" ] || continue

    archive_path="$CACHE/$filename"
    partial_path="$archive_path.part"
    package_url="$MIRROR/$ARCH/$repository/$filename"

    echo "package:    $package_name $version" >&2
    echo "repository: $repository" >&2

    if [ -f "$archive_path" ]; then
        echo "found in cache: $filename" >&2
    else
        echo "downloading: $package_url" >&2
        rm -f "$partial_path"
        download_to "$package_url" "$partial_path"
        mv -f "$partial_path" "$archive_path"
        echo "saved: $archive_path" >&2
    fi

    if [ "$DOWNLOAD_ONLY" -eq 0 ]; then
        install_archive "$archive_path" "$PREFIX"
    fi
done < "$INSTALL_ORDER"
